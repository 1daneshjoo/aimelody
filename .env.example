# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string

# MySQL 8
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=aimelody
MYSQL_PASSWORD=aimelody_secret
MYSQL_DATABASE=aimelody

# IPPanel Edge — عضویت OTP بدون پترن (webservice متن آزاد)
# کلید را از پنل: Developers > Access Keys بگیرید
IPPANEL_ACCESS_KEY=
# شماره خط ارسال‌کننده (مثلاً +983000505)
IPPANEL_FROM=
# اگر true باشد، در نبود اعتبار SMS، کد فقط در لاگ سرور چاپ می‌شود
OTP_DEV_FALLBACK=true

# امضای آپلود به dl.aimelody.ir
DL_BASE_URL=https://dl.aimelody.ir
DL_SIGNING_SECRET=change-me-dl-signing-secret
DL_UPLOAD_TTL_SEC=900
