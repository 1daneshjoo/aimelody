# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string

# MySQL 8
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Laragon پیش‌فرض: root بدون پسورد — نام دیتابیس را خودت بساز (مثلاً melody)
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=melody

# IPPanel Edge — OTP با پترن
# کلید را از پنل: Developers > Access Keys بگیرید
IPPANEL_ACCESS_KEY=
# شماره خط ارسال‌کننده (مثلاً +983000505)
IPPANEL_FROM=
# کد پترن OTP در پنل IPPanel
IPPANEL_OTP_PATTERN_CODE=
# اگر خالی باشد از IPPANEL_FROM استفاده می‌شود
IPPANEL_OTP_PATTERN_SENDER=
# نام متغیرهای داخل پترن
IPPANEL_OTP_PATTERN_VAR_CODE=code
IPPANEL_OTP_PATTERN_VAR_MINUTES=minutes
IPPANEL_OTP_PATTERN_VAR_APP=app
# مقدار نام اپ داخل پترن
IPPANEL_OTP_PATTERN_APP_NAME=AiMelody
# اگر true باشد، در نبود اعتبار SMS، کد فقط در لاگ سرور چاپ می‌شود
OTP_DEV_FALLBACK=true

# امضای آپلود و آدرس عمومی فایل‌ها روی dl
DL_BASE_URL=https://dl.aimelody.ir
NEXT_PUBLIC_DL_BASE_URL=https://dl.aimelody.ir
DL_SIGNING_SECRET=change-me-dl-signing-secret
DL_UPLOAD_TTL_SEC=900

# آپلود فایل روی dl — اولویت با API سی‌پنل روی IP (DNS دامنه گاه قطع می‌شود)
DL_CPANEL_BASE_URL=https://158.58.190.44:2083
DL_CPANEL_IP=158.58.190.44
DL_CPANEL_PORT=2083
DL_CPANEL_USER=
DL_CPANEL_PASSWORD=
DL_CPANEL_DOCROOT=/home/USERNAME/public_html
# برای اتصال با IP معمولاً باید true باشد
DL_CPANEL_TLS_INSECURE=true

# FTP مستقیم (اغلب فیلتر/بسته است) — اختیاری
DL_FTP_HOST=
DL_FTP_PORT=21
DL_FTP_USER=
DL_FTP_PASSWORD=
DL_FTP_SECURE=false
DL_FTP_BASE_DIR=
# فقط توسعه محلی؛ در production همیشه false باشد تا فایل اشتباهاً روی دامنه اصلی نرود
DL_UPLOAD_LOCAL_FALLBACK=false

# آپلود HTTPS با PHP (اختیاری؛ اگر سی‌پنل نباشد)
DL_HTTP_UPLOAD_URL=
DL_HTTP_UPLOAD_SECRET=
